module

import GroupRings
import Mathlib.Algebra.Group.Submonoid.Membership
import Mathlib.Algebra.Group.Subgroup.ZPowers.Basic
import Mathlib.LinearAlgebra.Matrix.Notation
import Mathlib.RingTheory.Finiteness.Basic

/-!
# Generating augmentation ideals through the public API

Two free-monoid generators suffice over a noncommutative matrix coefficient
ring, including their product difference, and give a finitely generated left
ideal. For the infinite cyclic group, the inverse difference lies in the span
of the positive generator difference even though the inverse is not in the
submonoid generated by that positive generator.
-/

open MonoidAlgebra

noncomputable section

-- The coefficient ring in the two-generator example is noncommutative.
example :
    (!![(0 : ℤ), 1; 0, 0] : Matrix (Fin 2) (Fin 2) ℤ) * !![0, 0; 1, 0] ≠
      !![0, 0; 1, 0] * !![0, 1; 0, 0] := by
  intro h
  have hh := congrFun (congrFun h 0) 0
  norm_num [Matrix.mul_apply, Fin.sum_univ_two] at hh

-- This uses a genuine two-letter word, not a group or an identity-only monoid.
example :
    single (FreeMonoid.of false * FreeMonoid.of true)
        (1 : Matrix (Fin 2) (Fin 2) ℤ) - 1 ∈
      Ideal.span ((fun s : FreeMonoid Bool =>
        single s (1 : Matrix (Fin 2) (Fin 2) ℤ) - 1) ''
        Set.range (FreeMonoid.of : Bool → FreeMonoid Bool)) ∧
    single (FreeMonoid.of false * FreeMonoid.of true)
        (1 : Matrix (Fin 2) (Fin 2) ℤ) - 1 ≠
      (0 : MonoidAlgebra (Matrix (Fin 2) (Fin 2) ℤ) (FreeMonoid Bool)) ∧
    (RingHom.ker (augmentation (Matrix (Fin 2) (Fin 2) ℤ) (FreeMonoid Bool))).FG := by
  have hker := ker_augmentation_eq_span_of_submonoid_closure_eq_top
    (Matrix (Fin 2) (Fin 2) ℤ) (FreeMonoid Bool)
    (Set.range FreeMonoid.of) FreeMonoid.closure_range_of
  refine ⟨?_, ?_, ?_⟩
  · rw [← hker]
    simp [RingHom.mem_ker]
  · intro h
    have hs : of (Matrix (Fin 2) (Fin 2) ℤ) (FreeMonoid Bool)
        (FreeMonoid.of false * FreeMonoid.of true) =
        of (Matrix (Fin 2) (Fin 2) ℤ) (FreeMonoid Bool) 1 := by
      simpa [MonoidAlgebra.one_def] using sub_eq_zero.mp h
    have hw := congrArg FreeMonoid.toList (of_injective hs)
    simp at hw
  · rw [hker]
    exact Submodule.fg_span ((Set.finite_range _).image _)

-- The subgroup route genuinely reaches an inverse unavailable to the monoid route.
example :
    (Multiplicative.ofAdd (1 : ℤ))⁻¹ ∉
      Submonoid.closure ({Multiplicative.ofAdd (1 : ℤ)} : Set (Multiplicative ℤ)) ∧
    single ((Multiplicative.ofAdd (1 : ℤ))⁻¹) (1 : ℤ) - 1 ∈
      Ideal.span ((fun s : Multiplicative ℤ => single s (1 : ℤ) - 1) ''
        {Multiplicative.ofAdd (1 : ℤ)}) ∧
    single ((Multiplicative.ofAdd (1 : ℤ))⁻¹) (1 : ℤ) - 1 ≠
      (0 : MonoidAlgebra ℤ (Multiplicative ℤ)) := by
  have hgen :
      Subgroup.closure ({Multiplicative.ofAdd (1 : ℤ)} : Set (Multiplicative ℤ)) = ⊤ := by
    apply top_unique
    intro g _
    refine Subgroup.mem_closure_singleton.mpr ⟨g.toAdd, ?_⟩
    apply Multiplicative.toAdd.injective
    simp [toAdd_zpow]
  refine ⟨?_, ?_, ?_⟩
  · intro h
    obtain ⟨n, hn⟩ := Submonoid.mem_closure_singleton.mp h
    have hn' := congrArg Multiplicative.toAdd hn
    simp only [toAdd_pow, toAdd_ofAdd, toAdd_inv, nsmul_eq_mul, mul_one] at hn'
    omega
  · rw [← ker_augmentation_eq_span_of_subgroup_closure_eq_top
      ℤ (Multiplicative ℤ) _ hgen]
    simp [RingHom.mem_ker]
  · intro h
    have hs : of ℤ (Multiplicative ℤ) ((Multiplicative.ofAdd (1 : ℤ))⁻¹) =
        of ℤ (Multiplicative ℤ) 1 := by
      simpa [MonoidAlgebra.one_def] using sub_eq_zero.mp h
    have ht := congrArg Multiplicative.toAdd (of_injective hs)
    norm_num at ht
