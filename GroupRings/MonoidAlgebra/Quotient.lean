module

public import GroupRings.MonoidAlgebra.Augmentation
public import GroupRings.MonoidAlgebra.SubgroupIdeals
public import Mathlib.GroupTheory.QuotientGroup.Basic
public import Mathlib.RingTheory.Ideal.Quotient.Operations

/-!
# Group rings of quotient groups

For a normal subgroup `N`, the canonical index map to the group ring of `G ⧸ N`
has kernel the left ideal generated by `single n 1 - 1`. Its first-isomorphism
equivalence preserves every coefficient. A ring homomorphism out of the group
ring factors uniquely through this map exactly when it sends each `single n 1`
to one; the target need only be a semiring.

The coefficient-kernel argument uses `cosetSum` and `mem_span_subgroup_iff`.
The equivalence and factorization use Mathlib's ideal quotient and first
isomorphism APIs. No commutativity or nontriviality of the coefficient ring is
required.
-/

@[expose] public section

noncomputable section

universe u v w

namespace MonoidAlgebra

variable (R : Type u) {G : Type v} [Group G]

/-- The coefficients of the quotient index map are the sums over left cosets. -/
theorem coeff_mapDomainRingHom_mk' [Semiring R] (N : Subgroup G) [N.Normal]
    (f : MonoidAlgebra R G) :
    (mapDomainRingHom R (QuotientGroup.mk' N) f).coeff = cosetSum R N f := by
  rfl

variable [Ring R]

/-- The kernel of the quotient index map is the left span of the subgroup relations. -/
theorem ker_mapDomainRingHom_mk' (N : Subgroup G) [N.Normal] :
    RingHom.ker (mapDomainRingHom R (QuotientGroup.mk' N)) =
      Ideal.span (Set.range fun n : N => single (n : G) (1 : R) - 1) := by
  ext f
  rw [RingHom.mem_ker, mem_span_subgroup_iff,
    ← coeff_mapDomainRingHom_mk', coeff_eq_zero]

/-- Normality makes the left span of the subgroup relations a two-sided ideal. -/
instance instIsTwoSidedSpanSubgroup (N : Subgroup G) [N.Normal] :
    (Ideal.span (Set.range fun n : N => single (n : G) (1 : R) - 1)).IsTwoSided :=
  span_subgroup_isTwoSided R N inferInstance

/-- The group ring of a quotient group is the quotient by the subgroup relations. -/
def quotientSpanSubgroupEquiv (N : Subgroup G) [N.Normal] :
    (MonoidAlgebra R G ⧸
      Ideal.span (Set.range fun n : N => single (n : G) (1 : R) - 1)) ≃+*
      MonoidAlgebra R (G ⧸ N) :=
  (Ideal.quotEquivOfEq (ker_mapDomainRingHom_mk' R N).symm).trans
    (RingHom.quotientKerEquivOfSurjective
      (mapDomainRingHom_surjective R G (QuotientGroup.mk' N)
        (QuotientGroup.mk'_surjective N)))

/-- On every quotient class the equivalence is the canonical index map. -/
@[simp] theorem quotientSpanSubgroupEquiv_mk (N : Subgroup G) [N.Normal]
    (f : MonoidAlgebra R G) :
    quotientSpanSubgroupEquiv R N (Ideal.Quotient.mk _ f) =
      mapDomainRingHom R (QuotientGroup.mk' N) f := by
  simp [quotientSpanSubgroupEquiv]

/-- The quotient equivalence preserves the coefficient of every group basis term. -/
theorem quotientSpanSubgroupEquiv_mk_single (N : Subgroup G) [N.Normal]
    (g : G) (r : R) :
    quotientSpanSubgroupEquiv R N (Ideal.Quotient.mk _ (single g r)) =
      single (QuotientGroup.mk' N g) r := by
  rw [quotientSpanSubgroupEquiv_mk]
  exact mapDomain_single

/-- The values on quotient classes characterize the quotient equivalence uniquely. -/
theorem quotientSpanSubgroupEquiv_unique (N : Subgroup G) [N.Normal]
    (e : (MonoidAlgebra R G ⧸
      Ideal.span (Set.range fun n : N => single (n : G) (1 : R) - 1)) ≃+*
      MonoidAlgebra R (G ⧸ N))
    (h : ∀ f, e (Ideal.Quotient.mk _ f) =
      mapDomainRingHom R (QuotientGroup.mk' N) f) :
    e = quotientSpanSubgroupEquiv R N := by
  apply RingEquiv.ext
  intro x
  obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective x
  exact (h f).trans (quotientSpanSubgroupEquiv_mk R N f).symm

variable {S : Type w} [Semiring S]

/-- Killing the left span is equivalent to sending every subgroup basis unit to one.
Only addition in the target is used, so the target need not be a ring. -/
theorem span_subgroup_le_ker_iff (N : Subgroup G)
    (θ : MonoidAlgebra R G →+* S) :
    Ideal.span (Set.range fun n : N => single (n : G) (1 : R) - 1) ≤
      RingHom.ker θ ↔ ∀ n : N, θ (single (n : G) 1) = 1 := by
  rw [Ideal.span_le]
  constructor
  · intro h n
    have hn : θ (single (n : G) 1 - 1) = 0 := h ⟨n, rfl⟩
    calc
      θ (single (n : G) 1) = θ ((single (n : G) 1 - 1) + 1) := by
        rw [sub_add_cancel]
      _ = 1 := by rw [map_add, hn, map_one, zero_add]
  · intro h x hx
    obtain ⟨n, rfl⟩ := hx
    change θ (single (n : G) 1 - 1) = 0
    calc
      θ (single (n : G) 1 - 1) = θ (single (n : G) 1) + θ (-1) := by
        rw [sub_eq_add_neg, map_add]
      _ = θ (1 : MonoidAlgebra R G) + θ (-1) := by rw [h n, map_one]
      _ = 0 := by rw [← map_add, add_neg_cancel, map_zero]

/-- A homomorphism factors uniquely through the quotient index map if and only if
it sends every basis unit from the normal subgroup to one. -/
theorem existsUnique_comp_mapDomainRingHom_mk'_iff (N : Subgroup G) [N.Normal]
    (θ : MonoidAlgebra R G →+* S) :
    (∃! ψ : MonoidAlgebra R (G ⧸ N) →+* S,
      ψ.comp (mapDomainRingHom R (QuotientGroup.mk' N)) = θ) ↔
      ∀ n : N, θ (single (n : G) 1) = 1 := by
  constructor
  · rintro ⟨ψ, hψ, _⟩
    apply (span_subgroup_le_ker_iff R N θ).mp
    rw [← ker_mapDomainRingHom_mk' R N]
    intro a ha
    rw [RingHom.mem_ker] at ha ⊢
    have h := DFunLike.congr_fun hψ a
    change ψ (mapDomainRingHom R (QuotientGroup.mk' N) a) = θ a at h
    rw [← h, ha, map_zero]
  · intro hθ
    have hker := (span_subgroup_le_ker_iff R N θ).mpr hθ
    let lift := Ideal.Quotient.lift
      (Ideal.span (Set.range fun n : N => single (n : G) (1 : R) - 1)) θ
      (fun a ha => hker ha)
    let ψ := lift.comp (quotientSpanSubgroupEquiv R N).symm.toRingHom
    have hψ : ψ.comp (mapDomainRingHom R (QuotientGroup.mk' N)) = θ := by
      apply RingHom.ext
      intro a
      change lift ((quotientSpanSubgroupEquiv R N).symm
        (mapDomainRingHom R (QuotientGroup.mk' N) a)) = θ a
      rw [← quotientSpanSubgroupEquiv_mk R N a, RingEquiv.symm_apply_apply]
      exact Ideal.Quotient.lift_mk _ θ (fun a ha => hker ha)
    refine ⟨ψ, hψ, ?_⟩
    intro ψ' hψ'
    apply RingHom.ext
    intro b
    obtain ⟨a, rfl⟩ := mapDomainRingHom_surjective R G (QuotientGroup.mk' N)
      (QuotientGroup.mk'_surjective N) b
    exact (DFunLike.congr_fun hψ' a).trans (DFunLike.congr_fun hψ a).symm

/-- Every factor through the quotient index map has the full basis-coefficient formula. -/
theorem comp_mapDomainRingHom_mk'_single (N : Subgroup G) [N.Normal]
    (θ : MonoidAlgebra R G →+* S) (ψ : MonoidAlgebra R (G ⧸ N) →+* S)
    (hψ : ψ.comp (mapDomainRingHom R (QuotientGroup.mk' N)) = θ) (g : G) (r : R) :
    ψ (single (QuotientGroup.mk' N g) r) = θ (single g r) := by
  have h := DFunLike.congr_fun hψ (single g r)
  change ψ (mapDomain (QuotientGroup.mk' N) (single g r)) = θ (single g r) at h
  simpa only [mapDomain_single] using h

end MonoidAlgebra
