module

public import Mathlib.Algebra.MonoidAlgebra.MapDomain
public import Mathlib.RingTheory.Ideal.Maps

/-!
# Augmentation of monoid algebras

The augmentation sends a finitely supported monoid-algebra element to the sum of
its coefficients. It is a ring homomorphism even when the coefficient semiring
is noncommutative. Over a ring, its kernel is the left ideal generated by the
differences between monoid basis elements and the identity.

The construction uses Mathlib's map on monoid indices and its ring equivalence
from a singleton monoid algebra to the coefficient semiring. A kernel element
is the sum of `single 1 r * (single m 1 - 1)` over its coefficients `r` at indices
`m`: the correction terms sum to zero. Thus only left-ideal closure is needed.
-/

@[expose] public section

noncomputable section

universe u v w

namespace MonoidAlgebra

variable (R : Type u) (M : Type v)

section Semiring

variable [Semiring R] [Monoid M]
variable {N : Type w} [Monoid N]

/-- A surjective monoid homomorphism induces a surjective map of monoid algebras. -/
theorem mapDomainRingHom_surjective (f : M →* N) (hf : Function.Surjective f) :
    Function.Surjective (mapDomainRingHom R f) := by
  classical
  choose g hg using hf
  intro y
  refine ⟨y.coeff.sum (fun n r => single (g n) r), ?_⟩
  rw [map_finsuppSum]
  change y.coeff.sum (fun n r => mapDomain f (single (g n) r)) = y
  simpa only [mapDomain_single, hg] using sum_coeff_single y

/-- The coefficient-sum ring homomorphism of a monoid algebra. -/
def augmentation : MonoidAlgebra R M →+* R :=
  (uniqueRingEquiv (R := R) PUnit.{1}).toRingHom.comp
    (mapDomainRingHom R (1 : M →* PUnit.{1}))

/-- The augmentation is the sum of the coefficients. -/
theorem augmentation_apply (x : MonoidAlgebra R M) :
    augmentation R M x = x.coeff.sum (fun _ r => r) := by
  classical
  change (Finsupp.mapDomain (fun _ : M => (1 : PUnit.{1})) x.coeff) 1 = _
  rw [Finsupp.mapDomain_apply]
  simp

/-- A single monoid basis term augments to its coefficient. -/
@[simp]
theorem augmentation_single (m : M) (r : R) :
    augmentation R M (single m r) = r := by
  rw [augmentation_apply]
  simp

/-- Augmentation is natural with respect to monoid homomorphisms. -/
@[simp]
theorem augmentation_comp_mapDomainRingHom (f : M →* N) :
    (augmentation R N).comp (mapDomainRingHom R f) = augmentation R M := by
  rw [augmentation, augmentation, RingHom.comp_assoc, ← mapDomainRingHom_comp]
  rfl

/-- Mapping the indices along any function preserves the augmentation of an element. -/
@[simp]
theorem augmentation_mapDomain (f : M → N) (x : MonoidAlgebra R M) :
    augmentation R N (mapDomain f x) = augmentation R M x := by
  rw [augmentation_apply, augmentation_apply]
  exact Finsupp.sum_mapDomain_index (fun _ => rfl) (fun _ _ _ => rfl)

/-- The augmentation kernel pulls back along every map of monoid indices. -/
@[simp]
theorem comap_ker_augmentation (f : M →* N) :
    Ideal.comap (mapDomainRingHom R f) (RingHom.ker (augmentation R N)) =
      RingHom.ker (augmentation R M) := by
  rw [RingHom.comap_ker, augmentation_comp_mapDomainRingHom]

/-- The image of the augmentation kernel lies in the target augmentation kernel. -/
theorem map_ker_augmentation_le (f : M →* N) :
    Ideal.map (mapDomainRingHom R f) (RingHom.ker (augmentation R M)) ≤
      RingHom.ker (augmentation R N) := by
  rw [Ideal.map_le_iff_le_comap, comap_ker_augmentation]

/-- A surjective map of monoid indices maps onto the target augmentation kernel. -/
theorem map_ker_augmentation_of_surjective (f : M →* N) (hf : Function.Surjective f) :
    Ideal.map (mapDomainRingHom R f) (RingHom.ker (augmentation R M)) =
      RingHom.ker (augmentation R N) := by
  rw [← comap_ker_augmentation R M f]
  exact Ideal.map_comap_of_surjective _ (mapDomainRingHom_surjective R M f hf) _

end Semiring

section Ring

variable [Ring R] [Monoid M]

/-- The augmentation kernel is the left ideal generated by `single m 1 - 1`. -/
theorem ker_augmentation :
    RingHom.ker (augmentation R M) =
      Ideal.span (Set.range (fun m : M => single m (1 : R) - 1)) := by
  classical
  apply le_antisymm
  · intro x hx
    rw [RingHom.mem_ker, augmentation_apply] at hx
    have hsum : x.coeff.sum (fun _ r => single (1 : M) r) = 0 := by
      simpa only [singleAddHom_apply, hx, single_zero] using
        (map_finsuppSum (singleAddHom (1 : M)) x.coeff (fun _ r => r)).symm
    have hx' : x = x.coeff.sum (fun m r => single m r - single 1 r) := by
      rw [Finsupp.sum_sub, sum_coeff_single, hsum, sub_zero]
    rw [hx']
    -- Each coefficient multiplies its generator on the left.
    apply Submodule.sum_mem
    intro m _
    have hgen : single m (1 : R) - 1 ∈
        Ideal.span (Set.range (fun m : M => single m (1 : R) - 1)) :=
      Ideal.subset_span ⟨m, rfl⟩
    simpa [mul_sub] using
      (Ideal.span _).mul_mem_left (single (1 : M) (x.coeff m)) hgen
  · refine Ideal.span_le.mpr ?_
    rintro _ ⟨m, rfl⟩
    simp [RingHom.mem_ker]

end Ring

end MonoidAlgebra
