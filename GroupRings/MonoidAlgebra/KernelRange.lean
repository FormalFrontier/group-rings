module

public import GroupRings.MonoidAlgebra.Quotient
public import Mathlib.Algebra.Group.Submonoid.Operations

/-!
# Kernels and range quotients of group-ring maps

For a homomorphism `φ : G →* M` from a group to a monoid, the kernel of the
unchanged-coefficient pushforward is the left ideal generated by `single n 1 - 1`
for `n ∈ φ.ker`. The quotient is canonically ring-equivalent to the monoid algebra
of the submonoid `MonoidHom.mrange φ`. The coefficient ring may be noncommutative
or the zero ring; neither the target monoid nor its range needs a group instance.

The construction composes `quotientSpanSubgroupEquiv` with Mathlib's
`mapDomainRingEquiv`, using `QuotientGroup.lift` to identify the quotient group
with the range. The universal property allows an arbitrary semiring target.
Only for surjective `φ` does it assert factorization through the algebra of all
of `M`: killing the kernel alone does not give extension outside the range.
-/

@[expose] public section

noncomputable section

universe u v w z

namespace MonoidAlgebra

variable (R : Type u) {G : Type v} {M : Type w} [Group G] [Monoid M]

section Ring

variable [Ring R]

/-- The kernel of an index pushforward from a group is generated by its
identity-fiber relations, with no surjectivity or nontriviality assumption. -/
theorem ker_mapDomainRingHom (φ : G →* M) :
    RingHom.ker (mapDomainRingHom R φ) =
      Ideal.span (Set.range fun n : φ.ker => single (n : G) (1 : R) - 1) := by
  let l := QuotientGroup.lift φ.ker φ le_rfl
  have hl : Function.Injective l :=
    (QuotientGroup.injective_lift_iff φ.ker φ le_rfl).mpr rfl
  calc
    RingHom.ker (mapDomainRingHom R φ) =
        RingHom.ker ((mapDomainRingHom R l).comp
          (mapDomainRingHom R (QuotientGroup.mk' φ.ker))) := by
      rw [← mapDomainRingHom_comp]
      rfl
    _ = RingHom.ker (mapDomainRingHom R (QuotientGroup.mk' φ.ker)) :=
      RingHom.ker_comp_of_injective _ (mapDomain_injective hl)
    _ = _ := ker_mapDomainRingHom_mk' R φ.ker

/-- The quotient by the kernel subgroup relations is the monoid algebra of the
range submonoid. The quotient-group lift selects the canonical index equivalence. -/
def quotientSpanKerEquivMrange (φ : G →* M) :
    (MonoidAlgebra R G ⧸
      Ideal.span (Set.range fun n : φ.ker => single (n : G) (1 : R) - 1)) ≃+*
      MonoidAlgebra R (MonoidHom.mrange φ) :=
  (quotientSpanSubgroupEquiv R φ.ker).trans
    (mapDomainRingEquiv R (MulEquiv.ofBijective
      (QuotientGroup.lift φ.ker φ.mrangeRestrict
        (by intro g hg; exact Subtype.ext hg))
      ⟨(QuotientGroup.injective_lift_iff _ _ _).mpr (by
          ext g
          change φ g = 1 ↔ φ.mrangeRestrict g = 1
          exact ⟨fun h => Subtype.ext h, fun h => congrArg Subtype.val h⟩),
        QuotientGroup.lift_surjective_of_surjective _ _
          (MonoidHom.mrangeRestrict_surjective φ) _⟩))

/-- On every quotient class, the range equivalence is the unchanged-coefficient
pushforward to the range subtype. -/
@[simp] theorem quotientSpanKerEquivMrange_mk (φ : G →* M)
    (f : MonoidAlgebra R G) :
    quotientSpanKerEquivMrange R φ (Ideal.Quotient.mk _ f) =
      mapDomainRingHom R φ.mrangeRestrict f := by
  change mapDomainRingHom R
    (QuotientGroup.lift φ.ker φ.mrangeRestrict (by intro g hg; exact Subtype.ext hg))
    (quotientSpanSubgroupEquiv R φ.ker (Ideal.Quotient.mk _ f)) = _
  rw [quotientSpanSubgroupEquiv_mk]
  change ((mapDomainRingHom R _).comp
    (mapDomainRingHom R (QuotientGroup.mk' φ.ker))) f = _
  rw [← mapDomainRingHom_comp]
  rfl

/-- The range equivalence preserves every original basis coefficient. -/
theorem quotientSpanKerEquivMrange_mk_single (φ : G →* M) (g : G) (r : R) :
    quotientSpanKerEquivMrange R φ (Ideal.Quotient.mk _ (single g r)) =
      single (φ.mrangeRestrict g) r := by
  rw [quotientSpanKerEquivMrange_mk]
  exact mapDomain_single

/-- Values on quotient classes characterize the range equivalence. -/
theorem quotientSpanKerEquivMrange_unique (φ : G →* M)
    (e : (MonoidAlgebra R G ⧸
      Ideal.span (Set.range fun n : φ.ker => single (n : G) (1 : R) - 1)) ≃+*
      MonoidAlgebra R (MonoidHom.mrange φ))
    (h : ∀ f, e (Ideal.Quotient.mk _ f) = mapDomainRingHom R φ.mrangeRestrict f) :
    e = quotientSpanKerEquivMrange R φ := by
  apply RingEquiv.ext
  intro x
  obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective x
  exact (h f).trans (quotientSpanKerEquivMrange_mk R φ f).symm

/-- For a surjective index homomorphism the same quotient is the monoid algebra
of the whole target, via the stock equivalence from its range submonoid. -/
def quotientSpanKerEquivOfSurjective (φ : G →* M) (hφ : Function.Surjective φ) :
    (MonoidAlgebra R G ⧸
      Ideal.span (Set.range fun n : φ.ker => single (n : G) (1 : R) - 1)) ≃+*
      MonoidAlgebra R M :=
  (quotientSpanKerEquivMrange R φ).trans
    (mapDomainRingEquiv R
      ((MulEquiv.submonoidCongr (MonoidHom.mrange_eq_top.mpr hφ)).trans
        Submonoid.topEquiv))

/-- On every quotient class, the surjective equivalence is the original index map. -/
@[simp] theorem quotientSpanKerEquivOfSurjective_mk (φ : G →* M)
    (hφ : Function.Surjective φ) (f : MonoidAlgebra R G) :
    quotientSpanKerEquivOfSurjective R φ hφ (Ideal.Quotient.mk _ f) =
      mapDomainRingHom R φ f := by
  change mapDomainRingHom R (MonoidHom.mrange φ).subtype
    (quotientSpanKerEquivMrange R φ (Ideal.Quotient.mk _ f)) = _
  rw [quotientSpanKerEquivMrange_mk]
  change ((mapDomainRingHom R _).comp (mapDomainRingHom R φ.mrangeRestrict)) f = _
  rw [← mapDomainRingHom_comp]
  rfl

/-- The surjective equivalence preserves every original basis coefficient. -/
theorem quotientSpanKerEquivOfSurjective_mk_single (φ : G →* M)
    (hφ : Function.Surjective φ) (g : G) (r : R) :
    quotientSpanKerEquivOfSurjective R φ hφ (Ideal.Quotient.mk _ (single g r)) =
      single (φ g) r := by
  rw [quotientSpanKerEquivOfSurjective_mk]
  exact mapDomain_single

/-- Values on quotient classes characterize the surjective equivalence. -/
theorem quotientSpanKerEquivOfSurjective_unique (φ : G →* M)
    (hφ : Function.Surjective φ)
    (e : (MonoidAlgebra R G ⧸
      Ideal.span (Set.range fun n : φ.ker => single (n : G) (1 : R) - 1)) ≃+*
      MonoidAlgebra R M)
    (h : ∀ f, e (Ideal.Quotient.mk _ f) = mapDomainRingHom R φ f) :
    e = quotientSpanKerEquivOfSurjective R φ hφ := by
  apply RingEquiv.ext
  intro x
  obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective x
  exact (h f).trans (quotientSpanKerEquivOfSurjective_mk R φ hφ f).symm

variable {S : Type z} [Semiring S]

/-- For a surjective group-to-monoid map, a ring homomorphism factors uniquely
through the target monoid algebra exactly when it kills the kernel relations. -/
theorem existsUnique_comp_mapDomainRingHom_of_surjective_iff (φ : G →* M)
    (hφ : Function.Surjective φ) (θ : MonoidAlgebra R G →+* S) :
    (∃! ψ : MonoidAlgebra R M →+* S, ψ.comp (mapDomainRingHom R φ) = θ) ↔
      ∀ n : φ.ker, θ (single (n : G) 1) = 1 := by
  constructor
  · rintro ⟨ψ, hψ, _⟩ n
    have h := DFunLike.congr_fun hψ (single (n : G) 1)
    change ψ (mapDomain φ (single (n : G) 1)) = θ (single (n : G) 1) at h
    simpa only [mapDomain_single, MonoidHom.mem_ker.mp n.property, ← one_def,
      map_one] using h.symm
  · intro hθ
    have hker := (span_subgroup_le_ker_iff R φ.ker θ).mpr hθ
    let lift := Ideal.Quotient.lift
      (Ideal.span (Set.range fun n : φ.ker => single (n : G) (1 : R) - 1)) θ
      (fun a ha => hker ha)
    let ψ := lift.comp (quotientSpanKerEquivOfSurjective R φ hφ).symm.toRingHom
    have hψ : ψ.comp (mapDomainRingHom R φ) = θ := by
      apply RingHom.ext
      intro a
      change lift ((quotientSpanKerEquivOfSurjective R φ hφ).symm
        (mapDomainRingHom R φ a)) = θ a
      rw [← quotientSpanKerEquivOfSurjective_mk R φ hφ a, RingEquiv.symm_apply_apply]
      exact Ideal.Quotient.lift_mk _ θ (fun a ha => hker ha)
    refine ⟨ψ, hψ, ?_⟩
    intro ψ' hψ'
    apply RingHom.ext
    intro b
    obtain ⟨a, rfl⟩ := mapDomainRingHom_surjective R G φ hφ b
    exact (DFunLike.congr_fun hψ' a).trans (DFunLike.congr_fun hψ a).symm

/-- A ring homomorphism factors uniquely through the canonical range pushforward
exactly when it sends the kernel basis units to one. No extension outside the
range is asserted. -/
theorem existsUnique_comp_mapDomainRingHom_mrangeRestrict_iff (φ : G →* M)
    (θ : MonoidAlgebra R G →+* S) :
    (∃! ψ : MonoidAlgebra R (MonoidHom.mrange φ) →+* S,
      ψ.comp (mapDomainRingHom R φ.mrangeRestrict) = θ) ↔
      ∀ n : φ.ker, θ (single (n : G) 1) = 1 := by
  rw [existsUnique_comp_mapDomainRingHom_of_surjective_iff R
    φ.mrangeRestrict (MonoidHom.mrangeRestrict_surjective φ) θ]
  constructor
  · intro h n
    exact h ⟨n, Subtype.ext n.property⟩
  · intro h n
    exact h ⟨n, congrArg Subtype.val n.property⟩

end Ring

end MonoidAlgebra
