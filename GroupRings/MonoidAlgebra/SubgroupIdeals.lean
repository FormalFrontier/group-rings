module

public import Mathlib.Algebra.MonoidAlgebra.Module
public import Mathlib.RingTheory.Ideal.Span
public import Mathlib.Algebra.Module.Submodule.RestrictScalars
public import Mathlib.GroupTheory.GroupAction.Quotient

/-!
# Subgroup augmentation ideals

For a subgroup `H` of a group `G`, the left ideal generated by `single h 1 - 1`
consists exactly of the elements whose coefficient sum on every left coset of `H`
vanishes. The map `MonoidAlgebra.cosetSum` takes values in a finitely supported
coefficient module, with no normality assumption on `H`.

Over a nontrivial coefficient ring these ideals detect subgroup membership and
inclusion, and are two-sided exactly for normal subgroups. The characteristic
membership theorem and the implication from normality to two-sidedness also hold
over the zero ring. Coefficients need not commute; no group or coset finiteness
is required.
-/

@[expose] public section
noncomputable section
universe u v

namespace MonoidAlgebra

variable (R : Type u) {G : Type v} [Group G]

section Semiring
variable [Semiring R]

/-- Sum coefficients in each left coset, as an `R`-linear map to a coefficient module. -/
def cosetSum (H : Subgroup G) : MonoidAlgebra R G →ₗ[R] (G ⧸ H →₀ R) :=
  (Finsupp.lmapDomain R R (QuotientGroup.mk (s := H))).comp
    (coeffLinearEquiv R).toLinearMap

/-- A group basis term maps to the corresponding coset basis term. -/
@[simp] theorem cosetSum_single (H : Subgroup G) (g : G) (r : R) :
    cosetSum R H (single g r) = Finsupp.single (QuotientGroup.mk g) r := by
  simp [cosetSum]

/-- Coefficients are summed over finite support; the coset type may be infinite. -/
theorem cosetSum_apply (H : Subgroup G) (f : MonoidAlgebra R G) (c : G ⧸ H) :
    cosetSum R H f c = f.coeff.sum (fun g r => Finsupp.single (QuotientGroup.mk g) r c) := by
  simp [cosetSum, Finsupp.mapDomain_apply]

end Semiring

section Ring
variable [Ring R]

-- The stronger property is stable under left multiplication by associativity.
-- Only multiplication by group basis terms is needed in its generator case.
private theorem cosetSum_mul_subgroup_generator (H : Subgroup G) (h : H)
    (a : MonoidAlgebra R G) : cosetSum R H (a * (single (h : G) (1 : R) - 1)) = 0 := by
  induction a using MonoidAlgebra.induction_on with
  | of g =>
    simp only [of_apply, mul_sub, single_mul_single, mul_one, map_sub, cosetSum_single]
    rw [QuotientGroup.mk_mul_of_mem g h.property, sub_self]
  | add a b ha hb => simp [add_mul, ha, hb]
  | smul r a ha => simp [smul_mul_assoc, ha]

private theorem cosetSum_eq_zero_of_mem_span_subgroup (H : Subgroup G)
    {f : MonoidAlgebra R G}
    (hf : f ∈ Ideal.span (Set.range (fun h : H => single (h : G) (1 : R) - 1))) :
    cosetSum R H f = 0 := by
  have hstrong : ∀ a : MonoidAlgebra R G, cosetSum R H (a * f) = 0 := by
    induction hf using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨h, rfl⟩ := hx
      exact fun a => cosetSum_mul_subgroup_generator R H h a
    | zero => simp
    | add x y hx hy ihx ihy => simp [mul_add, ihx, ihy]
    | smul b x hx ih => exact fun a => by simpa only [smul_eq_mul, ← mul_assoc] using ih (a * b)
  simpa using hstrong 1

/-- An element belongs to the left span of the subgroup differences exactly when
its coefficient sum on every left coset is zero. No normality or nontriviality
hypothesis is required. -/
theorem mem_span_subgroup_iff (H : Subgroup G) (f : MonoidAlgebra R G) :
    f ∈ Ideal.span (Set.range (fun h : H => single (h : G) (1 : R) - 1)) ↔
      cosetSum R H f = 0 := by
  classical
  refine ⟨cosetSum_eq_zero_of_mem_span_subgroup R H, fun hf => ?_⟩
  let I := Ideal.span (Set.range (fun h : H => single (h : G) (1 : R) - 1))
  -- Lift each coset coefficient to one chosen representative. Each basis term
  -- differs from its lift by a left multiple of a subgroup generator.
  let L : (G ⧸ H →₀ R) →ₗ[R] MonoidAlgebra R G :=
    (coeffLinearEquiv R).symm.toLinearMap.comp (Finsupp.lmapDomain R R Quotient.out)
  have hL (c : G ⧸ H) (r : R) : L (Finsupp.single c r) = single c.out r := by
    simp [L]
  have hdiff (a : MonoidAlgebra R G) : a - L (cosetSum R H a) ∈ I := by
    induction a using MonoidAlgebra.induction_on with
    | of g =>
      let t := (QuotientGroup.mk (s := H) g).out
      have ht : t⁻¹ * g ∈ H := QuotientGroup.eq.mp (QuotientGroup.out_eq' _)
      have hgen : single (t⁻¹ * g) (1 : R) - 1 ∈ I :=
        Ideal.subset_span ⟨⟨t⁻¹ * g, ht⟩, rfl⟩
      have heq : single g (1 : R) - single t 1 =
          single t 1 * (single (t⁻¹ * g) 1 - 1) := by
        simp [mul_sub, single_mul_single]
      simpa only [of_apply, cosetSum_single, hL] using heq.symm ▸ I.mul_mem_left (single t 1) hgen
    | add a b ha hb =>
      simpa only [map_add, add_sub_add_comm] using I.add_mem ha hb
    | smul r a ha =>
      simpa only [map_smul, smul_sub, Submodule.restrictScalars_mem] using
        (I.restrictScalars R).smul_mem r ha
  simpa [hf] using hdiff f

/-- For a normal subgroup the left span of its differences is two-sided,
even over a trivial or noncommutative coefficient ring. -/
theorem span_subgroup_isTwoSided (H : Subgroup G) (hH : H.Normal) :
    (Ideal.span (Set.range (fun h : H => single (h : G) (1 : R) - 1))).IsTwoSided := by
  classical
  let I := Ideal.span (Set.range (fun h : H => single (h : G) (1 : R) - 1))
  have hgen (h : H) (b : MonoidAlgebra R G) : (single (h : G) (1 : R) - 1) * b ∈ I := by
    rw [← b.sum_coeff_single, Finsupp.sum, Finset.mul_sum]
    refine I.sum_mem fun g hg => ?_
    have hc : g⁻¹ * (h : G) * g ∈ H := by
      simpa using hH.conj_mem (h : G) h.property g⁻¹
    have hm : single (g⁻¹ * (h : G) * g) (1 : R) - 1 ∈ I :=
      Ideal.subset_span ⟨⟨_, hc⟩, rfl⟩
    have heq : (single (h : G) (1 : R) - 1) * single g (b.coeff g) =
        single g (b.coeff g) * (single (g⁻¹ * (h : G) * g) 1 - 1) := by
      simp [sub_mul, mul_sub, single_mul_single, mul_assoc]
    rw [heq]
    exact I.mul_mem_left _ hm
  refine ⟨fun {a} b ha => ?_⟩
  induction ha using Submodule.span_induction with
  | mem x hx => obtain ⟨h, rfl⟩ := hx; exact hgen h b
  | zero => simp
  | add x y hx hy ihx ihy => simpa [add_mul] using I.add_mem ihx ihy
  | smul c x hx ih => simpa only [smul_eq_mul, mul_assoc] using I.mul_mem_left c ih

variable [Nontrivial R]

/-- A basis difference belongs to a subgroup's left ideal precisely for elements
of that subgroup. Normality is not needed. -/
theorem single_sub_one_mem_span_subgroup_iff (H : Subgroup G) (g : G) :
    single g (1 : R) - 1 ∈
      Ideal.span (Set.range (fun h : H => single (h : G) (1 : R) - 1)) ↔ g ∈ H := by
  classical
  refine ⟨fun hg => ?_, fun hg => Ideal.subset_span ⟨⟨g, hg⟩, rfl⟩⟩
  have hq := (mem_span_subgroup_iff R H _).mp hg
  rw [map_sub, one_def, cosetSum_single, cosetSum_single, sub_eq_zero] at hq
  have hc : QuotientGroup.mk (s := H) g = QuotientGroup.mk (1 : G) := by
    by_contra hne
    have he := congrArg (fun f : G ⧸ H →₀ R => f (QuotientGroup.mk g)) hq
    simp [Finsupp.single_eq_of_ne hne] at he
  have hi : g⁻¹ ∈ H := by simpa using QuotientGroup.eq.mp hc
  simpa using H.inv_mem hi

/-- The order of subgroup left ideals reflects and preserves subgroup inclusion. -/
theorem span_subgroup_le_iff (H K : Subgroup G) :
    Ideal.span (Set.range (fun h : H => single (h : G) (1 : R) - 1)) ≤
      Ideal.span (Set.range (fun k : K => single (k : G) (1 : R) - 1)) ↔ H ≤ K := by
  constructor
  · intro h g hg
    exact (single_sub_one_mem_span_subgroup_iff R K g).mp
      (h (Ideal.subset_span ⟨⟨g, hg⟩, rfl⟩))
  · intro h
    apply Ideal.span_mono
    rintro _ ⟨g, rfl⟩
    exact ⟨⟨g, h g.property⟩, rfl⟩

/-- Over a nontrivial ring, the subgroup left ideal is two-sided exactly when
the subgroup is normal. -/
theorem span_subgroup_isTwoSided_iff (H : Subgroup G) :
    (Ideal.span (Set.range (fun h : H => single (h : G) (1 : R) - 1))).IsTwoSided ↔
      H.Normal := by
  refine ⟨fun hI => ?_, span_subgroup_isTwoSided R H⟩
  let I := Ideal.span (Set.range (fun h : H => single (h : G) (1 : R) - 1))
  let : I.IsTwoSided := hI
  refine ⟨fun h hh g => ?_⟩
  have hm : single h (1 : R) - 1 ∈ I := Ideal.subset_span ⟨⟨h, hh⟩, rfl⟩
  have hc := I.mul_mem_right (single g⁻¹ 1) (I.mul_mem_left (single g 1) hm)
  apply (single_sub_one_mem_span_subgroup_iff R H _).mp
  simpa [I, mul_sub, sub_mul, single_mul_single, one_def] using hc

end Ring
end MonoidAlgebra
