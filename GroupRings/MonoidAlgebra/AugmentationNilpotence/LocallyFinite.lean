module

public import Mathlib.RingTheory.Nilpotent.Defs
public import GroupRings.MonoidAlgebra.AugmentationNilpotence.Finite

/-!
# Elementwise nilpotence for locally finite p-group algebras

Over a ring in which the prime `p` vanishes, every augmentation-zero element
of a locally finite `p`-group algebra is nilpotent. The coefficient ring may
be noncommutative or zero, and the coefficient and group universes are independent.

Local finiteness is expressed by
`∀ s : Finset G, Finite (Subgroup.closure (s : Set G))`: every finite subset
of `G` generates a finite subgroup. The group need not be finite or abelian,
and no finite generating set or subgroup exhaustion is chosen.

## Proof outline

Restrict an element to the subgroup generated by its finite coefficient support.
This subgroup is finite and inherits the p-group property. Augmentation remains
zero under this restriction, so the finite-p-group augmentation bound
`MonoidAlgebra.augmentation_pow_card_eq_bot` gives a zero power in the subgroup
algebra. Pushing forward gives a zero power of the original element.
The argument reuses this library's finite-p-group augmentation API and Mathlib's
subgroup, coefficient-reindexing and ideal-power APIs.

## Limitations

The exponent may depend on the element. No uniform exponent or vanishing power
of the whole augmentation kernel is asserted for an infinite group.
-/

@[expose] public section

universe u v

namespace MonoidAlgebra

variable {R : Type u} [Ring R] {G : Type v} [Group G] {p : ℕ}

/-- Every augmentation-zero element of a locally finite `p`-group algebra is
nilpotent over a ring with `p = 0`. The nilpotence exponent may depend on the element. -/
theorem isNilpotent_of_augmentation_eq_zero (hp : p.Prime) (hR : (p : R) = 0)
    (hG : IsPGroup p G)
    (hfin : ∀ s : Finset G, Finite (Subgroup.closure (s : Set G)))
    (x : MonoidAlgebra R G) (hx : augmentation R G x = 0) : IsNilpotent x := by
  classical
  -- Restrict to the finite subgroup generated by the support.
  let H : Subgroup G := Subgroup.closure (x.coeff.support : Set G)
  let : Finite H := hfin x.coeff.support
  let j : H →* G := SubmonoidClass.subtype H
  have hj : Function.Injective j := SubmonoidClass.subtype_injective H
  have hsupp : ↑x.coeff.support ⊆ Set.range j := by
    intro g hg
    have hgH : g ∈ H := Subgroup.mem_closure.mpr (by
      intro K hK
      exact hK hg)
    exact ⟨⟨g, hgH⟩, rfl⟩
  let y : MonoidAlgebra R H := comapDomain j hj x
  have hmap : mapDomain j y = x := mapDomain_comapDomain hsupp hj
  have hy : augmentation R H y = 0 := by
    calc
      augmentation R H y = augmentation R G (mapDomain j y) :=
        (augmentation_mapDomain R H j y).symm
      _ = 0 := by rw [hmap, hx]
  have hymem : y ∈ RingHom.ker (augmentation R H) := by simpa using hy
  have hynil : y ^ Nat.card H = 0 := by
    have hmem := Ideal.pow_mem_pow hymem (Nat.card H)
    rw [augmentation_pow_card_eq_bot hp hR (hG.to_subgroup H)] at hmem
    simpa using hmem
  -- Reindex the finite sums on the coefficient data, without changing algebras.
  have hsum (a : H →₀ R) (k : G → R → G →₀ R) :
      (Finsupp.mapDomain j a).sum k = a.sum (fun h r => k (j h) r) := by
    have hs : (Finsupp.mapDomain j a).support =
        a.support.map ⟨j, hj⟩ :=
      Finsupp.support_mapDomain_embedding ⟨j, hj⟩ a
    have hl : (Finsupp.mapDomain j a).sum k =
        ∑ g ∈ (Finsupp.mapDomain j a).support, k g (Finsupp.mapDomain j a g) := by
      rfl
    have hr : a.sum (fun h r => k (j h) r) =
        ∑ h ∈ a.support, k (j h) (a h) := by
      rfl
    rw [hl, hr, hs]
    simp [hj]
  have hcoeff {M : Type v} [Group M] (a b : MonoidAlgebra R M) :
      (a * b).coeff = a.coeff.sum (fun h r =>
        b.coeff.sum (fun k s => Finsupp.single (h * k) (r * s))) := by
    -- Expand the elements as sums of canonical singles before multiplying.
    have hcoeff_sum (c : M →₀ R) (f : M → R → MonoidAlgebra R M) :
        (c.sum f).coeff = c.sum (fun h r => (f h r).coeff) := by
      change (∑ h ∈ c.support, f h (c h)).coeff =
        ∑ h ∈ c.support, (f h (c h)).coeff
      ext g
      simp
    have hexpand (c : MonoidAlgebra R M) :
        c.coeff.sum (fun h r => single h r) = c := by
      have hc : (c.coeff.sum (fun h r => single h r)).coeff = c.coeff := by
        rw [hcoeff_sum]
        simp
      ext g
      exact congrArg (fun f : M →₀ R => f g) hc
    calc
      (a * b).coeff =
          (a.coeff.sum (fun h r => single h r) *
            b.coeff.sum (fun k s => single k s)).coeff := by
        rw [hexpand a, hexpand b]
      _ = a.coeff.sum (fun h r =>
          b.coeff.sum (fun k s => Finsupp.single (h * k) (r * s))) := by
        rw [Finsupp.sum_mul]
        simp only [Finsupp.mul_sum, hcoeff_sum]
        simp
  have hmul (a b : MonoidAlgebra R H) :
      mapDomain j (a * b) = mapDomain j a * mapDomain j b := by
    have hc : (mapDomain j a * mapDomain j b).coeff =
        Finsupp.mapDomain j (a * b).coeff := by
      calc
        (mapDomain j a * mapDomain j b).coeff =
            (Finsupp.mapDomain j a.coeff).sum (fun h r =>
              (Finsupp.mapDomain j b.coeff).sum (fun k s =>
                Finsupp.single (h * k) (r * s))) := by
          simpa using hcoeff (mapDomain j a) (mapDomain j b)
        _ = a.coeff.sum (fun h r => b.coeff.sum (fun k s =>
            Finsupp.single (j h * j k) (r * s))) := by
          simp only [hsum]
        _ = Finsupp.mapDomain j (a * b).coeff := by
          simp [hcoeff, Finsupp.mapDomain_sum]
    ext g
    simpa using congrArg (fun f : G →₀ R => f g) hc.symm
  have hpow (n : ℕ) : (mapDomain j y) ^ n = mapDomain j (y ^ n) := by
    induction n with
    | zero => simp
    | succ n ih =>
      simp only [pow_succ, ih]
      exact (hmul (y ^ n) y).symm
  refine ⟨Nat.card H, ?_⟩
  calc
    x ^ Nat.card H = (mapDomain j y) ^ Nat.card H := by rw [hmap]
    _ = mapDomain j (y ^ Nat.card H) := hpow _
    _ = 0 := by simp [hynil]

end MonoidAlgebra
