module

public import GroupRings.MonoidAlgebra.AugmentationNilpotence
public import GroupRings.MonoidAlgebra.Quotient

/-!
# Augmentation nilpotence for finite p-groups

For a finite `p`-group over any ring with `p = 0`, the canonical augmentation
kernel has zero `Nat.card G`-th power. Coefficients need not commute, and the
zero coefficient ring is included. Equivalently, every ordered mixed product
of that many augmentation elements vanishes.

The proof inducts on the group order. A central subgroup of order `p` gives a
smaller quotient; its group-ring kernel is generated by `single z 1 - 1` and
has zero `p`-th power. Ideal extension sends powers into powers without a
commutativity assumption. The quotient bound therefore places a power of the
augmentation ideal inside this nilpotent kernel. Multiplication of degrees and
Lagrange's theorem give the exact cardinal bound.

Together with the uniform arbitrary-group converse, this gives the finite-group
criterion over nontrivial coefficient rings. Finiteness is not omitted from the
forward implication.

## References

For classical modular group-ring background, see D. S. Passman,
*The Algebraic Structure of Group Rings*, Wiley, 1977. The proof here is a
direct central-subgroup induction using Mathlib's group-theoretic results,
with arbitrary coefficient rings rather than only fields.
-/

@[expose] public section

universe u v

namespace MonoidAlgebra

variable {R : Type u} [Ring R] {G : Type v} [Group G] {p : ℕ}

private theorem single_sub_one_pow_eq_zero (hp : p.Prime) (hR : (p : R) = 0)
    {z : G} (hz : z ^ p = 1) : (single z (1 : R) - 1) ^ p = 0 := by
  cases subsingleton_or_nontrivial R with
  | inl h => exact Subsingleton.elim _ _
  | inr h =>
    have : Fact p.Prime := ⟨hp⟩
    have : CharP (MonoidAlgebra R G) p :=
      (CharP.charP_iff_prime_eq_zero hp).mpr (by
        rw [← map_natCast (singleOneRingHom (R := R) (M := G)) p, hR, map_zero])
    rw [sub_pow_char_of_commute p (Commute.one_right _)]
    simp [single_pow, hz, one_def]

/-- If a normal cyclic subgroup is generated by an element whose `p`-th power
is one, the kernel of its group-ring quotient map has zero `p`-th power.
This includes the zero coefficient ring and noncommutative coefficients. -/
theorem ker_mapDomainRingHom_mk'_zpowers_pow_eq_bot (hp : p.Prime) (hR : (p : R) = 0)
    (z : G) [(Subgroup.zpowers z).Normal] (hz : z ^ p = 1) :
    (RingHom.ker (mapDomainRingHom R (QuotientGroup.mk' (Subgroup.zpowers z)))) ^ p = ⊥ := by
  have hker := ker_mapDomainRingHom_mk'_zpowers R z
  have : (Ideal.span ({single z (1 : R) - 1} : Set (MonoidAlgebra R G))).IsTwoSided :=
    hker ▸ inferInstance
  rw [hker, Ideal.span_singleton_pow, single_sub_one_pow_eq_zero hp hR hz]
  exact Ideal.span_singleton_eq_bot.mpr rfl

/-- The finite-p-group augmentation nilpotence bound: for any ring with
`p = 0`, the augmentation kernel has vanishing power of degree `Nat.card G`.
No nontriviality or commutativity hypothesis on the coefficient ring is needed.
See the module references for classical group-ring background. -/
theorem augmentation_pow_card_eq_bot [Finite G] (hp : p.Prime) (hR : (p : R) = 0)
    (hG : IsPGroup p G) :
    (RingHom.ker (augmentation R G)) ^ Nat.card G = ⊥ := by
  classical
  have : Fact p.Prime := ⟨hp⟩
  suffices h : ∀ n : ℕ, ∀ (H : Type v) [Group H] [Finite H], Nat.card H = n →
      IsPGroup p H → (RingHom.ker (augmentation R H)) ^ Nat.card H = ⊥ from
    h (Nat.card G) G rfl hG
  intro n
  induction n using Nat.strong_induction_on with
  | h n ih =>
    intro H _ _ hcard hH
    cases subsingleton_or_nontrivial H with
    | inl h =>
      have hker : RingHom.ker (augmentation R H) = ⊥ := by
        rw [ker_augmentation]
        apply le_antisymm _ bot_le
        refine Ideal.span_le.mpr ?_
        rintro _ ⟨g, rfl⟩
        rw [Subsingleton.elim g 1]
        simp [one_def]
      rw [hker]
      exact Ideal.bot_pow (Nat.ne_of_gt Nat.card_pos)
    | inr h =>
      have : Nontrivial (Subgroup.center H) := hH.center_nontrivial
      have hC := hH.to_subgroup (Subgroup.center H)
      have hdvd : p ∣ Nat.card (Subgroup.center H) := by
        obtain ⟨k, hk, hCcard⟩ := hC.nontrivial_iff_card.mp inferInstance
        rw [hCcard]
        exact dvd_pow_self p (Nat.ne_of_gt hk)
      obtain ⟨z, hz⟩ := exists_prime_orderOf_dvd_card' p hdvd
      let N := Subgroup.zpowers (z : H)
      have : N.Normal := Subgroup.normal_of_le_center (Subgroup.zpowers_le.mpr z.property)
      have hNcard : Nat.card N = p := by
        rw [Nat.card_zpowers, Subgroup.orderOf_coe, hz]
      have hmul : Nat.card H = Nat.card (H ⧸ N) * p := by
        rw [Subgroup.card_eq_card_quotient_mul_card_subgroup N, hNcard]
      have hlt : Nat.card (H ⧸ N) < n := by
        rw [← hcard, hmul]
        exact lt_mul_of_one_lt_right Nat.card_pos hp.one_lt
      have hquot := ih (Nat.card (H ⧸ N)) hlt (H ⧸ N) rfl (hH.to_quotient N)
      let q := mapDomainRingHom R (QuotientGroup.mk' N)
      have hkerpow : (RingHom.ker q) ^ p = ⊥ :=
        ker_mapDomainRingHom_mk'_zpowers_pow_eq_bot hp hR (z : H) (by
          rw [← orderOf_dvd_iff_pow_eq_one, Subgroup.orderOf_coe, hz])
      have hle : (RingHom.ker (augmentation R H)) ^ Nat.card (H ⧸ N) ≤
          RingHom.ker q := by
        have hmap := (Ideal.map_pow_le q (RingHom.ker (augmentation R H))
          (Nat.card (H ⧸ N))).trans (Ideal.pow_right_mono
            (map_ker_augmentation_le R H (QuotientGroup.mk' N)) (Nat.card (H ⧸ N)))
        rw [hquot] at hmap
        exact Ideal.map_le_iff_le_comap.mp hmap
      apply le_antisymm _ bot_le
      rw [hmul, Ideal.pow_mul]
      exact (Ideal.pow_right_mono hle p).trans hkerpow.le

/-- Every ordered mixed product of `Nat.card G` augmentation elements is zero
for a finite `p`-group over any ring with `p = 0`, including the zero ring. -/
theorem augmentation_list_prod_eq_zero [Finite G] (hp : p.Prime) (hR : (p : R) = 0)
    (hG : IsPGroup p G) (l : List (MonoidAlgebra R G)) (hl : l.length = Nat.card G)
    (hmem : ∀ x ∈ l, x ∈ RingHom.ker (augmentation R G)) : l.prod = 0 :=
  (Ideal.pow_eq_bot_iff_forall_list_prod_eq_zero _ _).mp
    (augmentation_pow_card_eq_bot hp hR hG) l hl hmem

/-- Over a nontrivial ring with `p = 0` for prime `p`, a finite group has
nilpotent augmentation ideal exactly when it is a `p`-group. -/
theorem isNilpotent_augmentation_iff_isPGroup [Nontrivial R] [Finite G]
    (hp : p.Prime) (hR : (p : R) = 0) :
    IsNilpotent (RingHom.ker (augmentation R G)) ↔ IsPGroup p G := by
  refine ⟨isPGroup_of_isNilpotent_augmentation hp hR, fun hG => ?_⟩
  exact ⟨Nat.card G, augmentation_pow_card_eq_bot hp hR hG⟩

end MonoidAlgebra
