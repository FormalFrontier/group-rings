module

public import GroupRings.MonoidAlgebra.FiberNormalization
public import Mathlib.Algebra.MonoidAlgebra.Basic

import Mathlib.Algebra.Group.TypeTags.Hom
import Mathlib.Logic.Function.Basic

/-!
# Binomial kernels of monoid-algebra maps

For a homomorphism of monoids, the kernel of the induced map of monoid algebras
is generated by the unit-coefficient basis differences whose indices have the
same image. The coefficient ring and both monoids may be noncommutative. Here
`Ideal.span` denotes a left ideal.

The proof passes to the additive type tag using the canonical algebra
structure over the integers. It chooses a representative in each inhabited
fiber and applies coefficientwise normalization in the transported ideal.
Coefficient scaling turns the unit-coefficient relations into all-coefficient
relations, without requiring the coefficient ring to be commutative.

## References

* `GroupRings.MonoidAlgebra.FiberNormalization` provides the coefficientwise
  normalization principle.
* Mathlib provides the monoid-algebra maps, coefficient modules, and
  additive/multiplicative type-tag equivalences used in the transport.
-/

@[expose] public section

universe uK uR uN uM

namespace MonoidAlgebra

private theorem toAdditiveAlgEquiv_mapDomainRingHom
    (K : Type uK) (R : Type uR) [CommSemiring K] [Semiring R] [Algebra K R]
    {N : Type uN} {M : Type uM} [Monoid N] [Monoid M] (f : N →* M)
    (p : MonoidAlgebra R N) :
    toAdditiveAlgEquiv K R M (mapDomainRingHom R f p) =
      AddMonoidAlgebra.mapDomainRingHom R f.toAdditive
        (toAdditiveAlgEquiv K R N p) := by
  have h :
      (toAdditiveAlgEquiv K R M).toRingEquiv.toRingHom.comp (mapDomainRingHom R f) =
        (AddMonoidAlgebra.mapDomainRingHom R f.toAdditive).comp
          (toAdditiveAlgEquiv K R N).toRingEquiv.toRingHom := by
    ext <;> simp [MonoidHom.coe_toAdditive]
  exact DFunLike.congr_fun h p

/-- The kernel of an index map is the left ideal generated by all
unit-coefficient basis differences with equal images. The coefficient ring and
both monoids may be noncommutative; the index map need not be surjective. -/
theorem ker_mapDomainRingHom_eq_span_fiber
    (R : Type uR) {N : Type uN} {M : Type uM}
    [Ring R] [Monoid N] [Monoid M] (f : N →* M) :
    RingHom.ker (mapDomainRingHom R f) =
      Ideal.span {p : MonoidAlgebra R N |
        ∃ a b : N, f a = f b ∧ p = single a (1 : R) - single b (1 : R)} := by
  classical
  let I : Ideal (MonoidAlgebra R N) :=
    Ideal.span {p : MonoidAlgebra R N |
      ∃ a b : N, f a = f b ∧ p = single a (1 : R) - single b (1 : R)}
  let e := (toAdditiveAlgEquiv ℤ R N).toRingEquiv
  let J : Ideal (AddMonoidAlgebra R (Additive N)) := Ideal.comap e.symm.toRingHom I
  let g : Additive N →+ Additive M := f.toAdditive
  let normal : Additive M → Additive N := Function.invFun (g : Additive N → Additive M)
  have he_single (a : N) (r : R) :
      e (single a r) = AddMonoidAlgebra.single (Additive.ofMul a) r :=
    toAdditiveAlgEquiv_single (R := ℤ) a r
  have he_symm_single (a : Additive N) (r : R) :
      e.symm (AddMonoidAlgebra.single a r) = single a.toMul r := by
    apply e.injective
    simp only [e.apply_symm_apply, he_single, ofMul_toMul]
  have hsingle (a : Additive N) (r : R) :
      r • AddMonoidAlgebra.single a (1 : R) = AddMonoidAlgebra.single a r := by
    simpa only [AddMonoidAlgebra.lsingle_apply, smul_eq_mul, mul_one] using
      (LinearMap.map_smul
        (AddMonoidAlgebra.lsingle (R := R) a :
          R →ₗ[R] AddMonoidAlgebra R (Additive N)) r (1 : R)).symm
  have hnormal (a : Additive N) : g (normal (g a)) = g a :=
    Function.invFun_eq ⟨a, rfl⟩
  have hbasis (a : Additive N) (r : R) :
      AddMonoidAlgebra.single a r - AddMonoidAlgebra.single (normal (g a)) r ∈ J := by
    have hunit : AddMonoidAlgebra.single a (1 : R) -
        AddMonoidAlgebra.single (normal (g a)) (1 : R) ∈ J := by
      change e.symm (AddMonoidAlgebra.single a (1 : R) -
        AddMonoidAlgebra.single (normal (g a)) (1 : R)) ∈ I
      rw [map_sub, he_symm_single, he_symm_single]
      refine Ideal.subset_span ⟨a.toMul, (normal (g a)).toMul, ?_, rfl⟩
      simpa only [g, MonoidHom.coe_toAdditive, Function.comp_apply,
        toMul_ofMul] using
        congrArg (fun m : Additive M => m.toMul) (hnormal a).symm
    -- Coefficient scaling preserves the left ideal through the scalar tower.
    simpa only [smul_sub, hsingle] using Submodule.smul_of_tower_mem J r hunit
  have ideal_le_kernel : I ≤ RingHom.ker (mapDomainRingHom R f) := by
    refine Ideal.span_le.mpr ?_
    rintro p ⟨a, b, hab, rfl⟩
    change mapDomainRingHom R f (single a (1 : R) - single b (1 : R)) = 0
    rw [map_sub]
    simp only [mapDomainRingHom_apply, mapDomain_single, hab, sub_self]
  refine le_antisymm ?_ ideal_le_kernel
  intro p hp
  have hkernel : e p ∈ RingHom.ker (AddMonoidAlgebra.mapDomainRingHom R g) := by
    apply RingHom.mem_ker.mpr
    calc
      AddMonoidAlgebra.mapDomainRingHom R g (e p) =
          toAdditiveAlgEquiv ℤ R M (mapDomainRingHom R f p) :=
        (toAdditiveAlgEquiv_mapDomainRingHom ℤ R f p).symm
      _ = 0 := by rw [RingHom.mem_ker.mp hp, map_zero]
  have hmem : e p ∈ J :=
    AddMonoidAlgebra.ker_mapDomainRingHom_le J g normal hbasis hkernel
  change e.symm (e p) ∈ I at hmem
  simpa only [e.symm_apply_apply] using hmem

end MonoidAlgebra
