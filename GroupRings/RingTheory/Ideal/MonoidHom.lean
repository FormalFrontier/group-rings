module

public import Mathlib.Algebra.Group.Action.Hom
public import Mathlib.Algebra.Group.Subgroup.Lattice
public import Mathlib.GroupTheory.GroupAction.Defs
public import Mathlib.LinearAlgebra.Quotient.Defs
public import Mathlib.RingTheory.Ideal.Defs

/-!
# Differences along monoid homomorphisms in left ideals

If `u s - 1` belongs to a left ideal for every generator `s`, the same holds
throughout the submonoid they generate, or the subgroup when the domain is a
group. The target is an arbitrary ring: it need not be commutative or a group.

The proofs use Mathlib's stabilizers of the point `1` in the left module
quotient by the ideal. This quotient is a module, not a quotient ring.
-/

@[expose] public section

universe u v

namespace Ideal

/-- Differences in a left ideal propagate along the submonoid generated by a set. -/
theorem sub_one_mem_of_mem_submonoid_closure
    {A : Type u} [Ring A] {M : Type v} [Monoid M]
    (I : Ideal A) (u : M →* A) {S : Set M}
    (hS : ∀ s ∈ S, u s - 1 ∈ I) {m : M}
    (hm : m ∈ Submonoid.closure S) : u m - 1 ∈ I := by
  have hmem (a : M) :
      a ∈ (MulAction.stabilizerSubmonoid A
        (Submodule.Quotient.mk (1 : A) : A ⧸ I)).comap u ↔ u a - 1 ∈ I := by
    rw [Submonoid.mem_comap, MulAction.mem_stabilizerSubmonoid_iff,
      ← Submodule.Quotient.mk_smul, smul_eq_mul, mul_one, Submodule.Quotient.eq]
  exact (hmem m).mp ((Submonoid.closure_le.mpr fun s hs => (hmem s).mpr (hS s hs)) hm)

/-- Differences in a left ideal propagate along the subgroup generated by a set.
No group structure on the target ring is required. -/
theorem sub_one_mem_of_mem_subgroup_closure
    {A : Type u} [Ring A] {G : Type v} [Group G]
    (I : Ideal A) (u : G →* A) {S : Set G}
    (hS : ∀ s ∈ S, u s - 1 ∈ I) {g : G}
    (hg : g ∈ Subgroup.closure S) : u g - 1 ∈ I := by
  let : MulAction G (A ⧸ I) := MulAction.compHom (A ⧸ I) u
  have hmem (a : G) :
      a ∈ MulAction.stabilizer G (Submodule.Quotient.mk (1 : A) : A ⧸ I) ↔
        u a - 1 ∈ I := by
    rw [MulAction.mem_stabilizer_iff, MulAction.compHom_smul_def,
      ← Submodule.Quotient.mk_smul, smul_eq_mul, mul_one, Submodule.Quotient.eq]
  exact (hmem g).mp (((Subgroup.closure_le _).mpr fun s hs => (hmem s).mpr (hS s hs)) hg)

end Ideal
